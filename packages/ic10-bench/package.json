{
	"name": "@tasermonkey/ic10-bench",
	"version": "1.3.0",
	"type": "module",
	"description": "Test harness for Stationeers IC10 scripts, built on the @tasermonkey/ic10 emulator (a fork of @stationeers-ic/ic10)",
	"license": "AGPL-3.0-or-later",
	"keywords": [
		"stationeers",
		"ic10",
		"vitest",
		"testing"
	],
	"homepage": "https://github.com/tasermonkey/ic10-bench/tree/main/packages/ic10-bench#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tasermonkey/ic10-bench.git",
		"directory": "packages/ic10-bench"
	},
	"bugs": {
		"url": "https://github.com/tasermonkey/ic10-bench/issues"
	},
	"bin": {
		"ic10-bench": "dist/bin/ic10-bench.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./config": {
			"source": "./src/config.ts",
			"types": "./dist/src/config.d.ts",
			"default": "./dist/src/config.js"
		},
		"./prefabs": {
			"source": "./src/prefabs.ts",
			"types": "./dist/src/prefabs.d.ts",
			"default": "./dist/src/prefabs.js"
		},
		"./checks": {
			"source": "./src/checks.ts",
			"types": "./dist/src/checks.d.ts",
			"default": "./dist/src/checks.js"
		},
		"./related-tests": {
			"source": "./src/related-tests.ts",
			"types": "./dist/src/related-tests.d.ts",
			"default": "./dist/src/related-tests.js"
		},
		"./vitest": {
			"source": "./src/matchers/vitest-setup.ts",
			"types": "./dist/src/matchers/vitest-setup.d.ts",
			"default": "./dist/src/matchers/vitest-setup.js"
		},
		"./debug-protocol": {
			"source": "./src/debug/protocol.ts",
			"types": "./dist/src/debug/protocol.d.ts",
			"default": "./dist/src/debug/protocol.js"
		},
		"./run-scenario": {
			"source": "./src/debug/run-scenario.ts",
			"types": "./dist/src/debug/run-scenario.d.ts",
			"default": "./dist/src/debug/run-scenario.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"catalog:build": "node --conditions=source tools/catalog-build.ts",
		"catalog:fixture": "node --conditions=source bin/ic10-bench.ts catalog --project test/fixtures/project",
		"pretest": "npm run catalog:build && npm run catalog:fixture",
		"test": "vitest run",
		"test:watch": "vitest",
		"pretypecheck": "npm run catalog:build && npm run catalog:fixture",
		"typecheck": "tsc -p tsconfig.json",
		"build": "npm run catalog:build && tsc -p tsconfig.build.json && node tools/copy-generated.ts",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@tasermonkey/ic10": "^1.0.1",
		"@tasermonkey/ic10-lint": "^1.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"vitest": ">=5"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	}
}
