{
	"name": "@tasermonkey/ic10-link",
	"version": "0.1.0",
	"type": "module",
	"description": "Links a folder of tested Stationeers IC10 scripts to the chips in your game, through the IC10Sync mod's chipdata folder",
	"license": "AGPL-3.0-or-later",
	"keywords": [
		"stationeers",
		"ic10",
		"ic10sync"
	],
	"homepage": "https://github.com/tasermonkey/ic10-bench/tree/main/packages/ic10-link#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tasermonkey/ic10-bench.git",
		"directory": "packages/ic10-link"
	},
	"bugs": {
		"url": "https://github.com/tasermonkey/ic10-bench/issues"
	},
	"bin": {
		"ic10-link": "dist/bin/ic10-link.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@tasermonkey/ic10-lint": "^1.0.2"
	},
	"peerDependencies": {
		"@tasermonkey/ic10-bench": ">=1.3.0",
		"vitest": ">=5"
	},
	"peerDependenciesMeta": {
		"@tasermonkey/ic10-bench": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	}
}
