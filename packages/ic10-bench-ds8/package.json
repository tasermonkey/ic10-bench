{
	"name": "@tasermonkey/ic10-bench-ds8",
	"version": "0.1.0",
	"type": "module",
	"description": "The DS-8 Server Rack mod for IC10 Bench: run Stationeers IC10 scripts in the rack's twelve processor sockets, with its drives, status registers and patch field",
	"license": "AGPL-3.0-or-later",
	"keywords": [
		"stationeers",
		"ic10",
		"ic10-bench",
		"server-rack"
	],
	"homepage": "https://github.com/tasermonkey/ic10-bench/tree/main/packages/ic10-bench-ds8#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tasermonkey/ic10-bench.git",
		"directory": "packages/ic10-bench-ds8"
	},
	"bugs": {
		"url": "https://github.com/tasermonkey/ic10-bench/issues"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@tasermonkey/ic10": ">=1.0.1",
		"@tasermonkey/ic10-bench": ">=1.3.0"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	}
}
